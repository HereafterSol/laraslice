{
    "name": "hereafter/laraslice",
    "description": "Future-Ready Clean Architecture & Vertical Slice Ecosystem for Enterprise, Gov & SaaS (Laravel & Flutter). Complete End-to-End SDLC from Design to Deploy via Visual UI, CLI & AI Prompts (IDE & Web MCP). Auto-generates Web, Mobile APIs, RBAC, Seeding & Audit Trails. By Hereafter Solutions.",
    "keywords": [
        "laravel",
        "laravel-13",
        "flutter",
        "vertical-slice",
        "clean-architecture",
        "modular",
        "odoo",
        "blatui",
        "ai",
        "mcp",
        "llm",
        "code-generator"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hereafter Solutions (H. Sol)",
            "homepage": "https://hereaftersol.com",
            "role": "Organization / Creator"
        },
        {
            "name": "Abdur Rehman",
            "homepage": "https://github.com/AbdurRehman712",
            "role": "Lead Architect & Creator"
        },
        {
            "name": "BrandUp",
            "homepage": "https://brandup247.com",
            "role": "Digital Marketing Partner"
        },
        {
            "name": "Muhammad Adnan",
            "email": "adnanansari901@gmail.com",
            "homepage": "https://github.com/adnanansari901",
            "role": "Contributor"
        }
    ],
    "require": {
        "php": "^8.2",
        "gehrisandro/tailwind-merge-php": "^1.1",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "laravel/sanctum": "^4.0",
        "lbuchs/webauthn": "^2.2",
        "mallardduck/blade-lucide-icons": "^2.0",
        "symfony/yaml": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18"
    },
    "suggest": {
        "bacon/bacon-qr-code": "^3.0 - render TOTP enrollment QR codes on the server instead of showing only the setup key"
    },
    "autoload": {
        "psr-4": {
            "LaraSlice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraSlice\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": [
            "@format --test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraSlice\\LaraSliceServiceProvider"
            ],
            "aliases": {
                "LaraSlice": "LaraSlice\\Facades\\LaraSlice"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://hereaftersol.com",
    "support": {
        "website": "https://hereaftersol.com",
        "marketing": "https://brandup247.com",
        "source": "https://github.com/hereaftersol/laraslice",
        "issues": "https://github.com/hereaftersol/laraslice/issues"
    }
}
