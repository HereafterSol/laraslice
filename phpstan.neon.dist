includes:
    - vendor/larastan/larastan/extension.neon
    # Pre-existing findings at adoption; fix entries and regenerate, never add new ones
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
    # Slice models get their columns from the migrations each slice ships
    databaseMigrationsPath:
        - database/migrations
        - src/Slices/Roles/Migrations
        - src/Slices/Settings/Migrations
        - src/Slices/Users/Migrations
    tmpDir: .phpstan.cache
