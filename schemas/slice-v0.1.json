{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sliceframework.dev/slice-v0.1.json",
  "title": "Slice YAML v0.1",
  "description": "Intent-only vertical slice manifest. No HTML. Closed formatter and field-type vocabularies.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["0.1", "0.1.0"]
    },
    "name": { "type": "string", "minLength": 1 },
    "handle": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "domain": { "type": "string" },
    "enabled": { "type": "boolean" },
    "active": { "type": "boolean" },
    "multitenant": { "type": "boolean" },
    "tenant_key": { "type": "string" },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    },
    "fields": {
      "description": "Legacy map form (handle → field). Prefer models[].fields in canonical v0.1.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "navigation": { "$ref": "#/$defs/navigation" },
    "ui": { "$ref": "#/$defs/ui" },
    "workflow": {
      "oneOf": [
        { "type": "boolean" },
        { "$ref": "#/$defs/workflow" }
      ]
    },
    "roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "version_history": { "type": "array" },
    "table": { "type": "string" },
    "permissions": { "type": "object" },
    "relations": { "type": "array" }
  },
  "additionalProperties": true,
  "$defs": {
    "fieldType": {
      "type": "string",
      "enum": ["string", "text", "integer", "decimal", "boolean", "date", "datetime", "timestamp"]
    },
    "formatter": {
      "type": "string",
      "enum": [
        "text",
        "text_with_badge",
        "status_pill",
        "date_time",
        "date_overdue",
        "money_breakdown",
        "progress_bar",
        "code_badge",
        "composite_user",
        "number"
      ]
    },
    "field": {
      "type": "object",
      "required": ["handle"],
      "properties": {
        "handle": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "type": { "$ref": "#/$defs/fieldType" },
        "required": { "type": "boolean" },
        "searchable": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "rules": { "type": "array" }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["handle", "table"],
      "properties": {
        "handle": { "type": "string" },
        "table": { "type": "string" },
        "root": { "type": "boolean" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["hasMany", "belongsTo", "belongsToMany", "hasOne"]
              },
              "model": { "type": "string" },
              "foreign_key": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "navigation": {
      "type": "object",
      "properties": {
        "group": { "type": "string" },
        "label": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "integer" },
        "visible": { "type": "boolean" },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hidden": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "column": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "handle": { "type": "string" },
        "label": { "type": "string" },
        "formatter": { "$ref": "#/$defs/formatter" },
        "type": { "$ref": "#/$defs/formatter" },
        "sortable": { "type": "boolean" },
        "badge_from": { "type": "string" },
        "breakdown": { "type": "object" },
        "html": { "type": "boolean" },
        "inferred_from": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": { "$ref": "#/$defs/column" }
            },
            "searchable": {
              "type": "array",
              "items": { "type": "string" }
            },
            "search_placeholder": { "type": "string" },
            "quick_filters": { "type": "array" },
            "sidebar_filters": { "type": "array" },
            "views": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["table", "board", "calendar", "card", "list"]
              }
            },
            "default_view": {
              "type": "string",
              "enum": ["table", "board", "calendar", "card", "list"]
            },
            "bulk_actions": { "type": "array" },
            "row_actions": { "type": "object" },
            "inline_edit": { "type": "array" },
            "summary_cards": { "type": "array" }
          },
          "additionalProperties": true
        },
        "forms": { "type": "object" },
        "show": { "type": "object" },
        "dashboard": { "type": "object" },
        "presentation": { "type": "object" }
      },
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "state_field": { "type": "string" },
        "state_column": { "type": "string" },
        "initial_state": { "type": "string" },
        "states": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "slug": { "type": "string" },
                  "label": { "type": "string" },
                  "color": { "type": "string" },
                  "initial": { "type": "boolean" }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
